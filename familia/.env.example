# Plantilla de variables de entorno — copiar a `.env` y completar valores.
# `.env` NO debe versionarse en git.

# Aplicacion
APP_NAME=Familia
APP_CONTEXT_PATH=/familia
APP_PORT_IN=8080
APP_PORT_OUT=8089

# Base de datos PostgreSQL
DB_NAME=familia
DB_HOST=localhost
DB_USER=changeme
DB_PASSWORD=changeme
DB_PORT_IN=5432
DB_PORT_OUT=5439
